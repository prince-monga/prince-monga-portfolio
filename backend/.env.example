# PostgreSQL: use the SSL-enabled managed connection URL (prefer a pooled URL at runtime).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# API server
PORT=4000
NODE_ENV=development

# Comma-separated exact browser origins. Add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173

# Generate a fresh secret for each environment; never reuse this placeholder.
# Example generator: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional one-time admin bootstrap. Remove both values immediately after creation.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Cloudflare R2 private-bucket credentials.
# Endpoint is derived from the account ID; delivery is proxied through the API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
