# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/prince_monga_dev

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Initial Admin Setup (one-time use) ───────────────────────────────────────
# Set these ONLY when running: npm run migrate (creates first admin account)
# Remove or leave blank after the admin account is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
